{
  "name": "clippy-desktop",
  "productName": "Clippy Desktop",
  "version": "0.1.0",
  "description": "Desktop Clippy buddy (Electron base with auto-update)",
  "main": "src/main.js",
  "author": "ttzac",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "typecheck": "tsc --noEmit -p .",
    "dist": "npm run build:renderer && electron-builder --win --publish never",
    "release": "npm run build:renderer && electron-builder --win --publish always",
    "test": "vitest run"
  },
  "build": {
    "appId": "au.com.trantech.clippy-desktop",
    "productName": "Clippy Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main.js",
      "src/preload.js",
      "dist-renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ttzac",
        "repo": "clippy-desktop"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron@44.9.0": true
  }
}
